{
  "expo": {
    "name": "BondCheck",
    "slug": "bondcheck",
    "scheme": "bondcheck",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F8",
    "platforms": [
      "android"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "pk.bondcheck.app",
      "versionCode": 100,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#4338CA"
      },
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F8",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0C0C0F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4338CA",
          "defaultChannel": "draws"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BondCheck uses the camera only when you choose to scan your prize bonds. Photos stay on your phone.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/noto-nastaliq-urdu/400Regular/NotoNastaliqUrdu_400Regular.ttf",
            "./node_modules/@expo-google-fonts/noto-nastaliq-urdu/700Bold/NotoNastaliqUrdu_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "extraProguardRules": "# WorkManager (used by expo-background-task) creates its Room database by reflection at startup;\n# R8 removed the generated class and the release app crashed on launch.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ],
      "./plugins/with-release-signing.js"
    ],
    "extra": {
      "apiBaseUrl": ""
    }
  }
}
