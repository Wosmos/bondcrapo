# BondCheck web app environment. Copy to .env.local for development (never commit .env.local).
# Every variable is optional: without one, the feature that needs it answers 503 or hides itself,
# and `bun run --cwd apps/web build` works with none set. Full list with owners: docs/OWNER_SETUP.md.

# --- Core -------------------------------------------------------------------------------------
# Neon pooled connection string (postgres://...). Required for every data page and endpoint.
DATABASE_URL=
# Production origin, e.g. https://bondcheck.pk (canonical URLs, hreflang, sitemap, Open Graph).
APP_BASE_URL=
# Bearer secret for /api/v1/cron/* (32+ random bytes: `openssl rand -base64 32`). Fails closed if unset.
CRON_SECRET=
# HMAC key for rate limit keys (32+ chars). Falls back to WALLET_PEPPER, then CRON_SECRET.
RATE_LIMIT_SECRET=

# --- Wallet -----------------------------------------------------------------------------------
# HMAC key for wallet tokens and sync codes (32+ random bytes). Set once and never rotate.
WALLET_PEPPER=
# Web Push (VAPID). Generate once with `bunx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:support@example.com
VAPID_SUBJECT=

# --- Markets ----------------------------------------------------------------------------------
# Optional MetalpriceAPI key, used when gold-api.com is down.
METALS_FALLBACK_API_KEY=
# Set to 1 only after the FreeGoldAPI licence is confirmed (monthly gold history before 2024).
MARKETS_ALLOW_FREEGOLDAPI=

# --- Android releases -------------------------------------------------------------------------
# Fine-grained GitHub token, read-only Contents access to this repository only.
GITHUB_RELEASES_TOKEN=
# owner/repo holding the releases (default Wosmos/bondcrapo).
GITHUB_RELEASES_REPO=

# --- Platform ---------------------------------------------------------------------------------
# vercel (default) or none. Read when pages are built, so set it before the build.
ANALYTICS_PROVIDER=

# --- Development and end-to-end tests only (ignored in production) ----------------------------
# BONDS_DATA=fixtures
# MARKETS_FIXTURE_FILE=src/features/markets/e2e/snapshot.json
