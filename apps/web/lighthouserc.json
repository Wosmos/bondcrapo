{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3104",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3104/en",
        "http://localhost:3104/ur",
        "http://localhost:3104/en/about/data",
        "http://localhost:3104/en/gold-rate",
        "http://localhost:3104/en/currency"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 122880 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
