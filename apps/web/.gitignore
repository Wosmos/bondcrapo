# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.bun-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/.lighthouseci/

# self-hosted scanner assets, copied by scripts/vendor-assets.mjs
/public/vendor/

# OpenNext and Wrangler output
/.open-next/
/.wrangler/

# Visual baselines are recorded on the Linux CI image only
/e2e/visual.spec.ts-snapshots/*-darwin.png
/e2e/visual.spec.ts-snapshots/*-win32.png
