{
  "name": "bondcheck",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "BondCheck: Pakistan prize bond results, anonymous wallets and market rates",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "@tailwindcss/oxide"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "lint": "bun run --filter \"*\" lint",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\" \"docs/**/*.md\" \"*.{json,md,mjs}\"",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "version": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
